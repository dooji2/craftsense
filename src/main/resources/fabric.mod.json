{
	"schemaVersion": 1,
	"id": "craftsense",
	"version": "${version}",
	"name": "CraftSense",
	"description": "Autocomplete for the crafting table. It tracks what you craft, suggests recipes, and lets you take the result from the output slot without placing the rest of the ingredients!",
	"authors": [
		"Dooji"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/craftsense/",
		"sources": "https://github.com/dooji2/craftsense"
	},
	"license": "GPL-v3",
	"icon": "assets/craftsense/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.dooji.craftsense.CraftSense"
		],
		"client": [
			"com.dooji.craftsense.CraftSenseClient"
		]
	},
	"mixins": [
		"craftsense.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": ">=0.161.0+26.3"
	}
}